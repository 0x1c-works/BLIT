<ui:FluentWindow
    x:Class="BLIT.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BLIT.WPF.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BLIT.WPF.Helpers"
    xmlns:local="clr-namespace:BLIT.WPF"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:banners="clr-namespace:BLIT.WPF.Pages.BannerIcons"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:settings="clr-namespace:BLIT.WPF.Pages.Settings"
    Title="{helpers:I18n AppTitle.Text}"
    Width="1440"
    Height="720"
    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Default"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  NavigationView in left panel  -->
        <ui:NavigationView
            Grid.Row="1"
            x:Name="MainNavigationView"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            Padding="42,0"
            >

            <ui:NavigationView.Resources>
                <!--  【终极修复】重写 Template，物理移除 ScrollViewer  -->
                <Style TargetType="{x:Type ui:NavigationViewContentPresenter}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ui:NavigationViewContentPresenter}">
                                <!--  源码里这里包了一层 ScrollViewer，我们直接去掉它，只留核心  -->
                                <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!--  顺便把垂直对齐拉伸，确保占满高度  -->
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </ui:NavigationView.Resources>
            
            <!--  Menu Items  -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="{helpers:I18n AppNavMenuBanner.Content}"
                    Icon="{ui:SymbolIcon Home24}"
                    Tag="BannerIcons"
                    TargetPageType="banners:BannerIconsPage" />
            </ui:NavigationView.MenuItems>

            <!--  Footer Menu Items  -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    x:Name="NavItem_Settings"
                    Content="{helpers:I18n AppNavMenuSettings.Content}"
                    Icon="{ui:SymbolIcon Settings20}"
                    Tag="Settings" 
                    TargetPageType="settings:SettingsPage"  />
                <ui:NavigationViewItem
                    x:Name="NavItem_Help"
                    Content="{helpers:I18n AppNavMenuHelp.Content}"
                    Icon="{ui:SymbolIcon QuestionCircle24}"
                    Command="{Binding OpenHelp}"
                    Tag="Help" />
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.ContentOverlay>
                <Grid>

                    <!--  Snackbar Container  -->
                    <controls:SnackbarContainer />
                </Grid>
            </ui:NavigationView.ContentOverlay>
        </ui:NavigationView>
        
        <!--  Loading Overlay  -->
        <controls:LoadingOverlay Grid.Row="1"/>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="{helpers:I18n AppTitle.Text}"
            Grid.Row="0"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/StoreLogo.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>