<Window x:Class="BLIT.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BLIT.WPF"
        xmlns:controls="clr-namespace:BLIT.WPF.Controls"
        xmlns:helpers="clr-namespace:BLIT.WPF.Helpers"
        xmlns:pages="clr-namespace:BLIT.WPF.Pages.BannerIcons"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="{helpers:I18n AppTitle.Text}"
        Height="720" 
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- NavigationView in left panel -->
        <ui:NavigationView 
            x:Name="MainNavigationView"
            Grid.Column="0"
            IsBackButtonVisible="Auto"
            IsPaneToggleVisible="True"
            PaneDisplayMode="Left"
            PaneTitle="{helpers:I18n AppTitle.Text}"
            SelectionChanged="NavigationView_SelectionChanged">
            
            <!-- Menu Items -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    x:Name="NavItem_BannerIcons"
                    Content="{helpers:I18n AppNavMenuBanner.Content}"
                    Icon="{ui:SymbolIcon Home24}"
                    Tag="BannerIcons"
                    TargetPageType="pages:BannerIconsPage" />
            </ui:NavigationView.MenuItems>
            
            <!-- Footer Menu Items -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    x:Name="NavItem_Help"
                    Content="{helpers:I18n AppNavMenuHelp.Content}"
                    Icon="{ui:SymbolIcon QuestionCircle24}"
                    MouseDown="NavItem_Help_MouseDown" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
        
        <!-- Content area in right panel -->
        <Frame x:Name="AppContent" Grid.Column="1" NavigationUIVisibility="Hidden" />
        
        <!-- Loading Overlay -->
        <controls:LoadingOverlay Grid.ColumnSpan="2" />
    </Grid>
</Window>


