<Page
    x:Class="BLIT.WPF.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BLIT.WPF.Helpers"
    xmlns:local="clr-namespace:BLIT.WPF.Pages.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingsPage"
    d:DesignHeight="1000"
    d:DesignWidth="800"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="Page_Loaded"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="32">

            <!--  Banner Settings  -->
            <ui:TextBlock FontTypography="Subtitle" Text="{helpers:I18n TextBannerSettingsTitle.Text}" />

            <ui:Card Margin="0,8,0,12">

                <StackPanel>
                    <!--  Scan Folders Editor  -->
                    <local:BannerSpriteScanFoldersEditor x:Name="BannerSpriteScanFoldersEditor" Margin="0,0,0,16" />

                    <!--  Group Start ID  -->
                    <Grid Margin="0,0,0,16" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="300"
                            Margin="0,0,0,16"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0,0,0,4"
                                FontTypography="Body"
                                Text="{helpers:I18n TextCustomBannerGroupStartID.Text}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{helpers:I18n TextCustomBannerGroupStartIDExplain.Text}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:NumberBox
                            x:Name="NumberBoxGroupStartID"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="200"
                            Maximum="99999"
                            Minimum="7"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding Banner.CustomGroupStartID, Mode=TwoWay}" />

                        <!--  Color Start ID  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="300"
                            VerticalAlignment="Center">
                            <ui:TextBlock
                                Margin="0,0,0,4"
                                FontTypography="Body"
                                Text="{helpers:I18n TextCustomBannerColorStartID.Text}"
                                TextWrapping="Wrap" />
                            <ui:TextBlock
                                FontTypography="Caption"
                                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                                Text="{helpers:I18n TextCustomBannerColorStartIDExplain.Text}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:NumberBox
                            x:Name="NumberBoxColorStartID"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="200"
                            Maximum="999999"
                            Minimum="194"
                            SpinButtonPlacementMode="Compact"
                            Value="{Binding Banner.CustomColorStartID, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>
            <!--  Appearance  -->
            <ui:TextBlock FontTypography="Subtitle" Text="{helpers:I18n TextAppearanceTitle.Text}" />

            <!--  Theme Selection  -->
            <ui:CardControl Margin="0,8,0,12" Icon="{ui:SymbolIcon Color24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            FontTypography="Body"
                            Text="{helpers:I18n TextTheme.Text}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select which app theme to display" />
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox
                    x:Name="ThemeComboBox"
                    Width="200"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{helpers:I18n ThemeLight}" />
                    <ComboBoxItem Content="{helpers:I18n ThemeDark}" />
                    <ComboBoxItem Content="{helpers:I18n ThemeHighContrast}" />
                </ComboBox>
            </ui:CardControl>

            <!--  Language Selection  -->
            <ui:CardControl Margin="0,0,0,0" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            FontTypography="Body"
                            Text="{helpers:I18n TextLanguage.Text}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select your preferred language" />
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox
                    x:Name="LanguageComboBox"
                    Width="200"
                    Margin="0,0,0,0"
                    HorizontalAlignment="Left"
                    SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en-US" />
                    <ComboBoxItem Content="简体中文" Tag="zh-CN" />
                </ComboBox>
            </ui:CardControl>

            <!--  About  -->
            <ui:TextBlock FontTypography="Subtitle" Text="{helpers:I18n TextAboutTitle.Text}" />

            <ui:CardExpander ContentPadding="0"
                             Icon="{ui:ImageIcon 'pack://application:,,,/Assets/StoreLogo.png', Width=50, Height=50}">
                <ui:CardExpander.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontTypography="Body"
                            Text="{helpers:I18n AppTitle.Text}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{helpers:I18n Copyright}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding Version, Mode=OneWay}" />
                    </Grid>
                </ui:CardExpander.Header>
                <StackPanel>
                    <ui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0"
                        NavigateUri="https://github.com/0x1-works/BLIT/issues/new">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:I18n SubmitIssue}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                        </Grid>
                    </ui:Anchor>
                    <ui:Anchor
                        Margin="0"
                        Padding="16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0,1,0,1"
                        CornerRadius="0"
                        NavigateUri="https://blit.0x1.best/">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{helpers:I18n ButtonViewHelp.Content}" />
                            <ui:SymbolIcon Grid.Column="1" Symbol="Link24" />
                        </Grid>
                    </ui:Anchor>
                </StackPanel>
            </ui:CardExpander>
        </StackPanel>
    </ScrollViewer>
</Page>