<Page x:Class="BLIT.WPF.Pages.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:helpers="clr-namespace:BLIT.WPF.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsPage">
    <ScrollViewer>
        <StackPanel Margin="32">
            <!-- Appearance -->
            <TextBlock Text="{helpers:I18n TextAppearanceTitle.Text}" 
                       Style="{StaticResource SectionTitleStyle}"/>
            
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{helpers:I18n TextTheme.Text}" 
                           Style="{StaticResource ItemLabelStyle}"/>
                <ComboBox x:Name="ThemeComboBox" 
                          Width="200" 
                          HorizontalAlignment="Left"
                          Margin="0,4,0,0"
                          SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{helpers:I18n ThemeLight}"/>
                    <ComboBoxItem Content="{helpers:I18n ThemeDark}" IsSelected="True"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{helpers:I18n TextLanguage.Text}" 
                           Style="{StaticResource ItemLabelStyle}"/>
                <ComboBox x:Name="LanguageComboBox" 
                          Width="200" 
                          HorizontalAlignment="Left"
                          Margin="0,4,0,0"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en-US"/>
                    <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                </ComboBox>
                <TextBlock Text="{helpers:I18n TextRequireRestart.Text}" 
                           Style="{StaticResource CaptionStyle}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- About -->
            <TextBlock Text="{helpers:I18n TextAboutTitle.Text}" 
                       Style="{StaticResource SectionTitleStyle}"/>
            
            <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{helpers:I18n TextVersion.Text}" 
                           Style="{StaticResource ItemLabelStyle}"/>
                <TextBlock Text="0.1.0 (WPF)" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Margin="0,16,0,0">
                <TextBlock Text="{helpers:I18n TextCreator.Text}" 
                           Style="{StaticResource ItemLabelStyle}"/>
                <TextBlock Text="{helpers:I18n TextCreatorValue.Text}" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
