<Page x:Class="BLIT.WPF.Pages.Settings.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:helpers="clr-namespace:BLIT.WPF.Helpers"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="SettingsPage"
      Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel Margin="32">
            <!-- Appearance -->
            <TextBlock Text="{helpers:I18n TextAppearanceTitle.Text}" 
                       Style="{StaticResource SectionTitleStyle}"/>
            
            <!-- Theme Selection -->
            <ui:CardControl Margin="0,8,0,12" Icon="{ui:SymbolIcon Color24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            FontTypography="Body"
                            Text="{helpers:I18n TextTheme.Text}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select which app theme to display" />
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeComboBox" 
                          Width="200" 
                          HorizontalAlignment="Left"
                          Margin="0,0,0,0"
                          SelectionChanged="ThemeComboBox_SelectionChanged">
                    <ComboBoxItem Content="{helpers:I18n ThemeLight}"/>
                    <ComboBoxItem Content="{helpers:I18n ThemeDark}" />
                    <ComboBoxItem Content="High Contrast"/>
                </ComboBox>
            </ui:CardControl>

            <!-- Language Selection -->
            <ui:CardControl Margin="0,0,0,0" Icon="{ui:SymbolIcon LocalLanguage24}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            FontTypography="Body"
                            Text="{helpers:I18n TextLanguage.Text}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Select your preferred language" />
                    </Grid>
                </ui:CardControl.Header>
                <ComboBox x:Name="LanguageComboBox" 
                          Width="200" 
                          HorizontalAlignment="Left"
                          Margin="0,0,0,0"
                          SelectionChanged="LanguageComboBox_SelectionChanged">
                    <ComboBoxItem Content="English" Tag="en-US"/>
                    <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                </ComboBox>
            </ui:CardControl>

            <!-- About -->
            <TextBlock Text="{helpers:I18n TextAboutTitle.Text}" 
                       Style="{StaticResource SectionTitleStyle}"/>
            
            <!-- Version -->
            <ui:CardControl Margin="0,8,0,12">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontTypography="Body"
                            Text="{helpers:I18n TextVersion.Text}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="1"
                            Margin="0,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="0.1.0 (WPF)" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Creator -->
            <ui:CardControl Margin="0,0,0,0">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:TextBlock
                            Grid.Row="0"
                            FontTypography="Body"
                            Text="{helpers:I18n TextCreator.Text}" />
                        <ui:TextBlock
                            Grid.Row="1"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{helpers:I18n TextCreatorValue.Text}" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
