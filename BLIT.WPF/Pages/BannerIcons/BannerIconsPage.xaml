<Page
    x:Class="BLIT.WPF.Pages.BannerIcons.BannerIconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:BLIT.WPF.Helpers"
    xmlns:local="clr-namespace:BLIT.WPF.Pages.BannerIcons"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:BLIT.WPF.Pages.BannerIcons.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:BLIT.WPF.Pages.BannerIcons.ViewModels"
    Title="BannerIconsPage"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    d:DesignHeight="600"
    d:DesignWidth="1000"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <helpers:InvertBoolConverter x:Key="InvertBoolConverter" />

        <!--  分组列表项模板  -->
        <DataTemplate x:Key="GroupItemTemplate" DataType="{x:Type model:BannerGroupEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="{Binding GroupID}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Orientation="Horizontal">
                    <TextBlock Foreground="Gray" Text="(" />
                    <TextBlock Foreground="Gray" Text="{Binding Icons.Count}" />
                    <TextBlock Foreground="Gray" Text=")" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header - 固定高度  -->
        <Border
            Grid.Row="0"
            Padding="24,16"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{helpers:I18n AppTitle.Text}" />
        </Border>

        <!--  菜单工具栏  -->
        <Border Grid.Row="1" Padding="12,0">
            <Menu VerticalAlignment="Center">
                <!--  文件菜单  -->
                <MenuItem
                    Command="{Binding NewProjectCommand}"
                    Header="{helpers:I18n AppButtonNewProject.Label}"
                    Icon="{ui:SymbolIcon Symbol=Document20}"
                    ToolTip="{helpers:I18n AppButtonNewProject.Label}" />

                <!--  保存项目  -->
                <MenuItem
                    Command="{Binding SaveProjectCommand}"
                    Header="{helpers:I18n AppButtonSaveProject.Label}"
                    Icon="{ui:SymbolIcon Symbol=Save20}"
                    ToolTip="{helpers:I18n AppButtonSaveProject.Label}" />

                <!--  另存为  -->
                <MenuItem
                    Command="{Binding SaveProjectAsCommand}"
                    Header="{helpers:I18n AppButtonSaveProjectAs.Label}"
                    Icon="{ui:SymbolIcon Symbol=SaveArrowRight20}"
                    ToolTip="{helpers:I18n AppButtonSaveProjectAs.Label}" />

                <!--  打开项目  -->
                <MenuItem
                    Command="{Binding OpenProjectCommand}"
                    Header="{helpers:I18n AppButtonOpenProject.Label}"
                    Icon="{ui:SymbolIcon Symbol=Folder20}"
                    ToolTip="{helpers:I18n AppButtonOpenProject.Label}" />

                <!--  分隔符  -->
                <Separator />

                <!--  导出菜单  -->
                <MenuItem Header="{helpers:I18n AppButtonExportAll.Label}" Icon="{ui:SymbolIcon Symbol=ArrowExportUp20}">
                    <MenuItem
                        Command="{Binding ExportAllCommand}"
                        Header="{helpers:I18n AppButtonExportAll.Label}"
                        ToolTip="{helpers:I18n AppButtonExportAll.Label}" />
                    <MenuItem
                        Command="{Binding ExportXMLCommand}"
                        Header="{helpers:I18n AppButtonExportXML.Label}"
                        ToolTip="{helpers:I18n AppButtonExportXML.Label}" />
                </MenuItem>

                <!--  分隔符  -->
                <Separator />

                <!--  纹理分辨率  -->
                <MenuItem
                    Width="200"
                    VerticalAlignment="Stretch"
                    IsSubmenuOpen="False">
                    <MenuItem.Header>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,6,0"
                                FontSize="14"
                                Text="⚙️" />
                            <TextBlock Text="{helpers:I18n LabelTextureResolution.Text}" />
                            <ComboBox
                                x:Name="comboOutputResolution"
                                MinWidth="100"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                SelectedValuePath="Tag"
                                SelectionChanged="comboOutputResolution_SelectionChanged">
                                <ComboBoxItem Content="2K" Tag="Res2K" />
                                <ComboBoxItem Content="4K" Tag="Res4K" />
                            </ComboBox>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
        </Border>

        <!--  主内容区域  -->
        <TabControl Grid.Row="2">
            <!--  分组编辑器标签页  -->
            <TabItem Header="{helpers:I18n PivotBannerGroupsEditor.Header}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  左侧分组列表  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock
                                FontWeight="Bold"
                                Text="{helpers:I18n TextBannerGroupListTitle.Text}"
                                TextAlignment="Center" />
                        </Border>

                        <Menu Grid.Row="1" FontSize="14">
                            <ui:MenuItem
                                Command="{Binding AddGroupCommand}"
                                Header="{helpers:I18n ButtonAdd.Content}"
                                Icon="{ui:SymbolIcon Symbol=Add20}" />
                            <ui:MenuItem
                                Command="{Binding DeleteGroupCommand}"
                                Header="{helpers:I18n ButtonDelete.Content}"
                                Icon="{ui:SymbolIcon Symbol=Delete20}" />
                        </Menu>

                        <ListBox
                            x:Name="listViewGroups"
                            Grid.Row="2"
                            ItemTemplate="{StaticResource GroupItemTemplate}"
                            ItemsSource="{Binding ViewModel.Groups}"
                            SelectionChanged="listViewGroups_SelectionChanged" />
                    </Grid>

                    <!--  右侧编辑区域  -->
                    <Border
                        Grid.Column="1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0">
                        <Grid>
                            <TextBlock
                                Padding="16"
                                Text="{helpers:I18n TextNoSelectedBannerGroup.Text}"
                                Visibility="{Binding ShowEmptyHint, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <local:BannerIconGroupEditor x:Name="bannerIconGroupEditor" Visibility="{Binding HasSelectedGroup, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!--  颜色编辑器标签页  -->
            <TabItem Header="{helpers:I18n PivotBannerColorsEditor.Header}">
                <local:BannerColorsEditor />
            </TabItem>
        </TabControl>
    </Grid>
</Page>