    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush"
                     Color="{StaticResource SolidBackgroundFillColorQuarternary}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush"
