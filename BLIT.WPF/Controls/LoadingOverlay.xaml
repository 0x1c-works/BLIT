<UserControl
    x:Class="BLIT.WPF.Controls.LoadingOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- ReSharper disable once Xaml.RedundantResource -->
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation
                Storyboard.TargetName="RootGrid"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Visibility="Collapsed" Opacity="0">
        <Grid>
            <Rectangle Fill="{ui:ThemeResource SurfaceStrokeColorDefaultBrush}" Opacity="0.8" />
            <Border
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                CornerRadius="8"
                Opacity="1">
                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                    <!--  Progress Ring + Message  -->
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:ProgressRing
                            Width="32"
                            Height="32"
                            Margin="0,0,16,0"
                            IsIndeterminate="True" />
                        <TextBlock
                            x:Name="MessageText"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                            Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>

                    <!--  Progress Text (shown only when IsShowingProgress is True)  -->
                    <StackPanel
                        Margin="0,16,0,0"
                        Orientation="Vertical"
                        Visibility="{Binding IsShowingProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            x:Name="ProgressText"
                            FontSize="12"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ProgressDisplayText, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='({0})'}"
                            TextAlignment="Center" />
                        <TextBlock
                            x:Name="PercentageText"
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ProgressPercentageString, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>