<UserControl x:Class="BLIT.WPF.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="RootGrid" Visibility="Collapsed">
        <Border Background="#B3000000">
            <Border Background="#E0000000" 
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Use standard WPF ProgressBar as indeterminate -->
                    <ProgressBar 
                        IsIndeterminate="True"
                        Width="32" 
                        Height="32"
                        Margin="0,0,16,0" />
                    <TextBlock 
                        x:Name="MessageText"
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="14"
                        Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
